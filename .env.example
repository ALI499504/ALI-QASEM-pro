# =============================================================================
# StockVision Pro — Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit backend/.env to git (already in .gitignore).
# =============================================================================

# ─── News & AI API Keys (optional – app works without them) ───────────────────
NEWSAPI_KEY=your_newsapi_key_here
LLM_PROVIDER=groq                             # groq | openai | gemini
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── App Config ───────────────────────────────────────────────────────────────
ENV=production                                # development | production

# CORS: comma-separated list of allowed frontend origins.
# Add your Vercel URL here after deployment, e.g.:
# CORS_ORIGIN=https://stockvision-pro.vercel.app,https://your-custom-domain.com
CORS_ORIGIN=http://localhost:5173

# ─── Databases ────────────────────────────────────────────────────────────────
# SQL Database (Supabase Postgres recommended for production)
DATABASE_URL=sqlite:///./stockvision.db

# MongoDB Atlas URI (required for user auth & credential storage)
# Get this from: MongoDB Atlas → Database → Connect → Drivers → Python
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stockvision?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/stockvision?retryWrites=true&w=majority

# ─── Authentication & Security ────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_strong_random_secret_here_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Scheduler & Forecasting ──────────────────────────────────────────────────
ML_RETRAIN_INTERVAL_HOURS=24
PRICE_REFRESH_SECONDS=10
FORECAST_CACHE_HOURS=6
MAX_FORECAST_HORIZON=90
OPPORTUNITY_SCAN_LIMIT=100
DEFAULT_FORECAST_MODEL=random_forest
FORECAST_MIN_HISTORY_DAYS=180
