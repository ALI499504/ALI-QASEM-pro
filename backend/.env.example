# News & AI API Keys (optional for basic features)
NEWSAPI_KEY=your_newsapi_key
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# App config
ENV=development
CORS_ORIGIN=http://localhost:5173

# Database - Use SQLite for local dev, PostgreSQL for production
# For local development:
DATABASE_URL=sqlite:///./stockvision.db
# For production (Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:port/database

# MongoDB (required for news sentiment, user analytics)
# Get URI from MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/dbname
MONGODB_URI=

# Authentication & Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Scheduler & Workers
ML_RETRAIN_INTERVAL_HOURS=24
PRICE_REFRESH_SECONDS=10
FORECAST_CACHE_HOURS=6
MAX_FORECAST_HORIZON=90
OPPORTUNITY_SCAN_LIMIT=100
DEFAULT_FORECAST_MODEL=random_forest
FORECAST_MIN_HISTORY_DAYS=180

# Production overrides (set in Render/Platform env vars):
# ENV=production
# CORS_ORIGIN=https://ali-qasem-pro.vercel.app
# DATABASE_URL=postgresql://...
# MONGODB_URI=mongodb+srv://...
# JWT_SECRET_KEY=<generated-secret>
